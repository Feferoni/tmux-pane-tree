#!/usr/bin/env python3

import sys
import os
import argparse
from tmux_pane_tree import (TmuxTree, TmuxError, create_from_layout, load_layout_file,
                            print_layout)
from rpc import find_nvim_socket, nvim_exec

DEFAULT_LAYOUT_FILE = os.path.expanduser('~/.tmux_pane_tree_layout.json')


def cmd_tree(tree: TmuxTree, _: argparse.Namespace) -> None:
    tree.print_tree()


def cmd_current(tree: TmuxTree, _: argparse.Namespace) -> None:
    current = tree.get_current_pane()
    if current:
        print(f"ID: {current.id}")
        print(f"Process: {current.get_process()}")
        print(f"Position: {current.x},{current.y}")
        print(f"Size: {current.width}x{current.height}")
    else:
        print("No active pane found", file=sys.stderr)
        sys.exit(1)


def cmd_neighbors(tree: TmuxTree, _: argparse.Namespace) -> None:
    current = tree.get_current_pane()
    if not current:
        print("No active pane found", file=sys.stderr)
        sys.exit(1)

    neighbors = current.get_neighbors()
    for direction, pane_id in neighbors.items():
        pane = tree.find_pane(pane_id)
        if pane:
            print(f"{direction}: {pane_id} - {pane.get_process()}")


def cmd_find_process(tree: TmuxTree, args: argparse.Namespace) -> None:
    current = tree.get_current_pane()
    if not current:
        print("No active pane found", file=sys.stderr)
        sys.exit(1)

    neighbors = current.get_neighbors()
    for direction, pane_id in neighbors.items():
        pane = tree.find_pane(pane_id)
        if pane and pane.has_subprocess(args.process):
            print(f"{direction}: {pane_id}")
            return

    print("Not found", file=sys.stderr)
    sys.exit(1)


def cmd_send_keys(tree: TmuxTree, args: argparse.Namespace) -> None:
    pane = tree.find_pane(args.pane_id)
    if pane:
        pane.send_keys(args.keys)
    else:
        print(f"Pane {args.pane_id} not found", file=sys.stderr)
        sys.exit(1)


def cmd_nvim_exec(tree: TmuxTree, args: argparse.Namespace) -> None:
    # If no pane_id provided, find nvim in neighbors
    if not args.pane_id:
        current = tree.get_current_pane()
        if not current:
            print("No active pane found", file=sys.stderr)
            sys.exit(1)

        neighbors = current.get_neighbors()
        # Positional first, then remaining IDs
        pane_ids = [neighbors[d] for d in ['left', 'right', 'up', 'down'] if d in neighbors]
        pane_ids += [v for k, v in neighbors.items() if k not in ('left', 'right', 'up', 'down')]
        pane = None
        for pane_id in pane_ids:
            p = tree.find_pane(pane_id)
            if p and p.has_subprocess('nvim'):
                pane = p
                break
        if not pane:
            print("No neovim found in neighbor panes", file=sys.stderr)
            sys.exit(1)
    else:
        pane = tree.find_pane(args.pane_id)
        if not pane:
            print(f"Pane {args.pane_id} not found", file=sys.stderr)
            sys.exit(1)

    socket = find_nvim_socket(pane.pid)
    if not socket:
        print("No neovim socket found for pane", file=sys.stderr)
        sys.exit(1)

    if not nvim_exec(socket, args.nvim_command):
        print("Failed to execute command in neovim", file=sys.stderr)
        sys.exit(1)

    if args.switch:
        pane.switch_to()


def cmd_layout(args: argparse.Namespace) -> None:
    """Create tmux sessions from a JSON layout file, or just print it."""
    spec = load_layout_file(args.file)
    targets = args.sessions or None
    print_layout(spec, targets=targets)
    if args.print_only:
        return
    session_ids = create_from_layout(spec, replace=args.replace, targets=targets)
    created_names = targets if targets else list(spec.keys())
    print()
    for name, session_id in zip(created_names, session_ids):
        print(f"created session {name} ({session_id})")


def main() -> None:
    parser = argparse.ArgumentParser(description='Tmux pane tree manager')
    subparsers = parser.add_subparsers(dest='command', required=True)

    subparsers.add_parser('tree', help='Print tree of sessions/windows/panes')
    subparsers.add_parser('current', help='Show current pane info')
    subparsers.add_parser('neighbors', help='List neighbor panes')

    find_parser = subparsers.add_parser('find', help='Find process in neighbors')
    find_parser.add_argument('process', help='Process name to find')

    send_parser = subparsers.add_parser('send', help='Send keys to pane')
    send_parser.add_argument('pane_id', help='Target pane ID')
    send_parser.add_argument('keys', help='Keys to send')

    nvim_parser = subparsers.add_parser('nvim_exec',
                                        help='Execute command in neovim without history')
    nvim_parser.add_argument('nvim_command', help='Neovim command to execute')
    nvim_parser.add_argument('-p',
                             '--pane',
                             dest='pane_id',
                             help='Target pane ID (optional, auto-detects nvim in neighbors)')
    nvim_parser.add_argument('-s',
                             '--switch',
                             action='store_true',
                             help='Switch to pane after execution')

    layout_parser = subparsers.add_parser(
        'layout', help='Create sessions/windows/panes from a JSON layout file')
    layout_parser.add_argument(
        'file',
        nargs='?',
        default=DEFAULT_LAYOUT_FILE,
        help=f'Path to the layout JSON file (default: {DEFAULT_LAYOUT_FILE})')
    layout_parser.add_argument('-r',
                               '--replace',
                               action='store_true',
                               help='Replace existing sessions of the same name')
    layout_parser.add_argument('-p',
                               '--print',
                               dest='print_only',
                               action='store_true',
                               help='Print the layout tree from the file without creating anything')
    layout_parser.add_argument('-s',
                               '--session',
                               dest='sessions',
                               action='append',
                               metavar='NAME',
                               help='Only create this session from the file '
                                    '(repeatable; default: all sessions)')

    args = parser.parse_args()

    commands = {
        'tree': cmd_tree,
        'current': cmd_current,
        'neighbors': cmd_neighbors,
        'find': cmd_find_process,
        'send': cmd_send_keys,
        'nvim_exec': cmd_nvim_exec,
    }

    try:
        if args.command == 'layout':
            cmd_layout(args)
        else:
            tree = TmuxTree()
            commands[args.command](tree, args)
    except TmuxError as exc:
        print(f"tmux error: {exc}", file=sys.stderr)
        sys.exit(1)
    except (ValueError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
